include README.md
include LICENSE
include CHANGELOG.md
include pyproject.toml
include setup.py
include requirements.txt
include requirements-dev.txt

# Include R script for BCOR
include src/mafs/filters/bcor_script.R

# Include data files
recursive-include src/mafs/data/datasets *.npz
recursive-include src/mafs/data/datasets *.md

# Include examples
recursive-include examples *.py
recursive-include examples *.md

# Exclude
global-exclude __pycache__
global-exclude *.py[co]
global-exclude .DS_Store
